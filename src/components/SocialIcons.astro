---
// Language switcher to the Japanese docs site, followed by Starlight social icons.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const otherOrigin = 'https://ja.docs.sunriselayer.io';
const href = `${otherOrigin}${Astro.url.pathname}`;
---

<a class="language-switch" href={href} lang="ja" hreflang="ja">日本語</a>
<Default><slot /></Default>
